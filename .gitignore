# =============================================================================
# Unity .gitignore — ZooWorld
# Base: github/gitignore Unity.gitignore + project-specific additions.
# Track: Assets/, Packages/ (manifest + packages-lock), ProjectSettings/,
#        .meta files, docs/, .editorconfig, .mcp.json, reviewed .claude/ config.
# Ignore: generated caches, user/local settings, IDE files, build output.
# =============================================================================

# ---- Unity generated folders ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Pp]rofiler[Cc]aptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---- IDE / editor ----
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# ---- Autogenerated VS / Rider solution & project files ----
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# ---- Builds ----
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Project-specific ----
# Sakura Games' internal task brief — kept local, captured in our own words in
# docs/product/game-design.md + README.md instead of redistributing the PDF.
/Zoo world_2026.pdf
